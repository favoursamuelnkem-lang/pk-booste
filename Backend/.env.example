# PK-BOOSTER backend environment (set these in Render, do not commit real secrets)
MONGODB_URI=
JWT_SECRET=
PORT=5000

# Admin login for the OG-style full admin dashboard
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Owlet provider
OWLET_API_URL=https://the-owlet.com/api/v2
OWLET_API_KEY=

# Resend email notifications
RESEND_API_KEY=
RESEND_FROM=PK-BOOSTER <welcome@pk-booster.com>
RESEND_REPLY_TO=

# Paystack deposits (existing PK-BOOSTER payment flow)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://pk-booster.com/payment-callback.html

# Website
FRONTEND_URL=https://pk-booster.com
WEBSITE_NAME=PK-BOOSTER
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false
